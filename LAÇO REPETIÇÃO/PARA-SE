programa
{//Faca um algoritmo que escreva os números pares de 10 a 2.
//Dica: para descobrir se um número é ou não par, basta dividirmos ele por 2 e 
//verificar se existe ou não resto da divisão.
//Existe um operado em portugol chamado mod para fazer essa operação.
	
	funcao inicio()
	{
		inteiro i, par

			para(i=10; i>=2; i--){
				se(i % 2 == 0){
					par = i
					escreva ("\n", i)
					
				}
			}
			
	}
}
